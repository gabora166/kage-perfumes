DATABASE_PATH=data/ateeq.sqlite
ADMIN_EMAIL=atelier@example.com
ADMIN_PASSWORD=change-this-password
# Required when NODE_ENV=production. At least 16 characters. There is no generated fallback.
SESSION_SECRET=replace-with-a-long-random-string
STORE_WHATSAPP=201000000000
# 0 when Node is reached directly. Use 1 or more only behind a proxy that appends the client address.
TRUSTED_PROXY_HOPS=0
NEXT_PUBLIC_SITE_URL=http://localhost:3000
